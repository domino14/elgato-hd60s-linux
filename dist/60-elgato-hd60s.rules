# Elgato Game Capture HD60 S (0fd9:0074)
#  - uaccess: give the logged-in desktop user access to the device
#  - SYSTEMD_USER_WANTS: start the capture service in that user's session
#    when the card is plugged in (it exits by itself when unplugged)
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0fd9", ATTR{idProduct}=="0074", \
  TAG+="uaccess", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="hd60s-capture.service"
